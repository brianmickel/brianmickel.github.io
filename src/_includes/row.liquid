{%- assign cat = entry.data.category | category -%}
<li class="row">
  <time class="row-date" datetime="{{ entry.date | isoDate }}">{{ entry.date | isoDate }}</time>
  <a class="row-cat" href="/{{ cat.slug }}/">{{ cat.tag }}</a>
  <div class="row-main">
    <a class="row-title" href="{{ entry.url }}">{{ entry.data.title }}</a>
    {%- if entry.data.summary %}<span class="row-summary">{{ entry.data.summary }}</span>{% endif -%}
  </div>
</li>
