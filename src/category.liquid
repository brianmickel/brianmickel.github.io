---
layout: base.liquid
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/{{ category.slug }}/"
eleventyComputed:
  title: "{{ category.name }}"
  description: "{{ category.blurb }}"
---
<section class="hero hero-small">
  <h1 class="page-title">{{ category.name }}</h1>
  <p class="tagline">{{ category.blurb }}</p>
</section>

{%- assign items = collections.stream | byCategory: category.slug -%}
{%- if items.size > 0 -%}
<ol class="stream" aria-label="{{ category.name }}, newest first">
  {%- for entry in items -%}
    {% include "row.liquid" %}
  {%- endfor -%}
</ol>
{%- else -%}
<p class="empty">Nothing filed here yet.</p>
{%- endif -%}
